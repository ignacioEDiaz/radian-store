{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --workspace @radian/web --workspace @radian/contracts --include-workspace-root=false",
  "buildCommand": "npm run build -w @radian/contracts && npm run build -w @radian/web",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "build": {
    "env": {
      "VITE_DEMO_VIEWER": "demo@radian.store:demo-password-123"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-c4f1aaa8.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://api-production-c4f1aaa8.up.railway.app/media/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://api-production-c4f1aaa8.up.railway.app/health/:path*"
    },
    { "source": "/((?!api/|media/|health/|assets/|cdn/|_hosts/).*)", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(cdn|_hosts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
