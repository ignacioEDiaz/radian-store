{
  "name": "@radian/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --project contract",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=.env src/scripts/migrate.ts",
    "load:pool": "autocannon -c 60 -d 20 http://localhost:3000/api/_diag/slow",
    "seed:catalog": "tsx --conditions=source --env-file-if-exists=.env src/scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@node-rs/argon2": "^2.2.2",
    "@radian/contracts": "*",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^8.0.0",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
